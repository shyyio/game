[Unit]
Description=Shy's Power-Up Factory (spup) reporting server
After=network.target
# Give up after 5 failed starts in 5 minutes: a boot-time crash (bad build, unwritable DB) then
# lands in "failed" instead of looping forever and looking merely "activating".
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/home/app/spup-reporting
ExecStart=/usr/bin/node dist-reportingserver/main.js --host 127.0.0.1 --port 27502 --db /home/app/data/reporting/reporting.sqlite3 --maps-dir /home/app/data/reporting/reporting-maps
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/app/data/reporting
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LimitCORE=0
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
MemoryMax=256M
TasksMax=64
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
