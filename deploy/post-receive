#!/usr/bin/env bash
set -euo pipefail
# Exported, not inline-prefixed: build:server's gitBuildInfo() shells out to git from a separate
# process, and the checked-out work tree holds no .git of its own.
export GIT_WORK_TREE=/home/app/spup
export GIT_DIR=/home/app/spup.git
git checkout -f main
cd /home/app/spup
npm ci
npm run build:server
# The server runs its mods as pinned packages, so build and pin this commit's in-repo loadout
# before restarting; the lockfile lives with the world data, the cache next to it.
node --import ./src/server/loader.js tools/publish-base-mods.js \
    --out /home/app/spup/dist-mods \
    --lockfile /home/app/data/game/mods.json
sudo /usr/bin/systemctl restart spup
