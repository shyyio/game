#!/usr/bin/env bash
set -euo pipefail
# Exported, not inline-prefixed: build:server's gitBuildInfo() shells out to git from a separate
# process, and the checked-out work tree holds no .git of its own.
export GIT_WORK_TREE=/home/app/spup
export GIT_DIR=/home/app/spup.git
git checkout -f main
cd /home/app/spup
npm ci
npm run build:server
npm run build:admin
# The server runs its mods as pinned packages, so build this commit's in-repo loadout and re-pin
# the base mods in the server's config before restarting; the config lives with the world data.
npm run mods:base -- --out /home/app/spup/build/mods
node build/server/modsCli.js sync-base --dist-mods /home/app/spup/build/mods --config /home/app/data/game/server.json
sudo /usr/bin/systemctl restart spup
