{
  "name": "shys-power-up-factory",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/bundle-badge.js client",
    "build:mod": "node --import ./src/nodeservice/loader.js tools/build-mod.js",
    "check:mod": "node --import ./src/nodeservice/loader.js tools/mod-check.js",
    "check:mods": "node --import ./src/nodeservice/loader.js tools/check-base-mods.js",
    "deploy": "node --import ./src/nodeservice/loader.js tools/deploy.js",
    "build:server": "vite build --config vite.server.config.js && node tools/bundle-badge.js server",
    "build:admin": "vite build --config vite.admin.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "build:auth": "vite build --config vite.auth.config.js",
    "build:reporting": "vite build --config vite.reporting.config.js",
    "serve": "node --import ./src/nodeservice/loader.js src/server/main.js",
    "serve:watch": "vite build --config vite.admin.config.js --watch & node --watch --import ./src/nodeservice/loader.js src/server/main.js",
    "serve:auth": "node --import ./src/nodeservice/loader.js src/authserver/main.js",
    "serve:auth:watch": "node --watch --import ./src/nodeservice/loader.js src/authserver/main.js",
    "serve:reporting": "node --import ./src/nodeservice/loader.js src/reportingserver/main.js",
    "serve:reporting:watch": "node --watch --import ./src/nodeservice/loader.js src/reportingserver/main.js",
    "test": "node --import ./src/test/test-loader.js --test 'src/**/*.spec.js'",
    "save:sample": "rm -f SAMPLE.sqlite3; node --import ./src/test/test-loader.js src/test/make-sample-save.js SAMPLE.sqlite3",
    "save:lines": "rm -f LINES.sqlite3; node --import ./src/test/test-loader.js src/test/make-lines-save.js LINES.sqlite3",
    "bench:lines": "node --expose-gc --import ./src/test/test-loader.js src/test/production-line-benchmark.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "better-sqlite3": "^12.11.1",
    "d3-axis": "^3.0.0",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "protobufjs": "^8.6.4",
    "simplex-noise": "^4.0.3",
    "source-map-js": "^1.2.1",
    "underscore": "^1.13.7",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuetify": "^3.9.5"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "playwright": "^1.62.1",
    "rollup": "^4.62.2",
    "sass-embedded": "^1.100.0",
    "terser": "5.50.0",
    "vite": "^7.0.6",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
