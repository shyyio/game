{
  "name": "shys-power-up-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "vite build --config vite.server.config.js",
    "build:authserver": "vite build --config vite.authserver.config.js",
    "serve": "node --import ./src/server/loader.js src/server/main.js",
    "serve:watch": "node --watch --import ./src/server/loader.js src/server/main.js",
    "serve:auth": "node --import ./src/server/loader.js src/authserver/main.js",
    "serve:auth:watch": "node --watch --import ./src/server/loader.js src/authserver/main.js",
    "test": "node --import ./src/test/test-loader.js --test 'src/**/*.spec.js'",
    "save:sample": "rm -f SAMPLE.sqlite3; node --import ./src/test/test-loader.js src/test/make-sample-save.js SAMPLE.sqlite3",
    "save:lines": "rm -f LINES.sqlite3; node --import ./src/test/test-loader.js src/test/make-lines-save.js LINES.sqlite3",
    "bench:lines": "node --expose-gc --import ./src/test/test-loader.js src/test/production-line-benchmark.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "protobufjs": "^8.6.4",
    "underscore": "^1.13.7",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4",
    "vuetify": "^3.9.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.62.1",
    "sass-embedded": "^1.100.0",
    "vite": "^7.0.6",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
